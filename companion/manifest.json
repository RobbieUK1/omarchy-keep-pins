{
  "manifest_version": 3,
  "name": "Omarchy Keep Pins",
  "version": "1.2.0",
  "description": "Pass pinned notes from the open Google Keep page to your local Omarchy dropdown.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Google Keep to sync pinned notes",
    "default_icon": {
      "16": "icons/bulb-16.png",
      "32": "icons/bulb-32.png",
      "48": "icons/bulb-48.png",
      "128": "icons/bulb-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://keep.google.com/*"
      ],
      "js": [
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/bulb-16.png",
    "32": "icons/bulb-32.png",
    "48": "icons/bulb-48.png",
    "128": "icons/bulb-128.png"
  }
}
